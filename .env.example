RESEND_API_KEY=
# Apex domain (verified in Resend) used as the From address for all contractor→customer
# email. Per-org local-part is derived from organizations.email_sender_local
# (e.g. "acme-roofing@<EMAIL_APEX_DOMAIN>"). DKIM/SPF/DMARC must be set up on this domain.
EMAIL_APEX_DOMAIN=
# Domain that receives inbound replies. Plus-addressing not used — reply-to is
# an opaque per-conversation alias: "r_xxxxxxxxxxxx@<EMAIL_REPLY_DOMAIN>".
EMAIL_REPLY_DOMAIN=
# Platform/system email — password reset, admin notifications, billing receipts.
# Strictly isolated from contractor→customer mail. Format: "Name <addr@domain>".
SYSTEM_FROM_EMAIL=
# Svix-format webhook signing secret from the Resend dashboard (starts with whsec_).
RESEND_WEBHOOK_SECRET=
# Optional: parallelism for the standalone email worker (default 4).
EMAIL_WORKER_CONCURRENCY=

APP_URL=
