SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
# Long-running worker (npm run worker) MUST use the SESSION pooler (port 5432) or a
# direct connection — NOT the transaction pooler (6543). The transaction pooler does
# not support LISTEN/NOTIFY (kills the outbox pg_notify wake) and drops long-lived
# connections. Same host/credentials as DATABASE_URL, only the port changes 6543 -> 5432.
WORKER_DATABASE_URL=
# Must be set via --env-file (not only worker.ts) so client.ts selects the worker
# DB config before ESM imports evaluate. Leave 'true' for the worker; unset elsewhere.
WORKER_RUNTIME=true

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_TOTP_SECRET=

SESSION_SECRET=

REDIS_URL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Telnyx (SMS provider — replaces or supplements Twilio)
# API key from Telnyx portal → API Keys
TELNYX_API_KEY=
# Ed25519 public key from Telnyx portal → API Keys → Public Key (base64)
TELNYX_PUBLIC_KEY=

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# Platform/system email — password reset, admin notifications, billing receipts.
# Sent via Brevo; SYSTEM_FROM_EMAIL's domain must be a verified Brevo sender.
# Strictly isolated from contractor→customer mail. Format: "Name <addr@domain>".
SYSTEM_FROM_EMAIL=
# Optional: parallelism for the standalone email worker (default 4).
EMAIL_WORKER_CONCURRENCY=

# Brevo — the only email provider. Per-tenant sending/receiving domains for
# contractor↔customer mail; platform domain for system mail. API key from the
# Brevo dashboard → SMTP & API → API Keys.
BREVO_API_KEY=
# Path secret for the account-wide Brevo transactional events webhook
# (/api/webhooks/brevo/events/{secret}). Strong random string; rejects mismatches.
BREVO_EVENTS_WEBHOOK_SECRET=

APP_URL=

# HMAC secret for signed appointment self-serve manage links (Phase 4).
# Generate with: openssl rand -hex 32
APPOINTMENT_MANAGE_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
PUBLIC_VAPID_KEY=
